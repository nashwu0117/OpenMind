{
  "name": "openmind",
  "version": "0.3.2",
  "private": true,
  "description": "Offline-first, print-first open-source mind mapping",
  "license": "Apache-2.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "test:updater": "node --test tests/updater.test.cjs",
    "package": "npm run build && node scripts/package.mjs",
    "dist:desktop": "npm run package",
    "licenses": "node scripts/licenses.mjs"
  },
  "dependencies": {
    "@fontsource/noto-sans-tc": "5.3.1",
    "@mathjax/src": "4.1.3",
    "lucide-react": "^0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@electron/osx-sign": "2.7.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "latest",
    "electron": "44.9.0",
    "typescript": "~5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
